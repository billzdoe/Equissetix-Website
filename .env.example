# Equissetix Website - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Analytics & Tracking
# ============================================================================

# Google Analytics 4 Measurement ID
# Get this from Google Analytics 4 console: https://analytics.google.com/
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook Pixel ID (optional)
# Get this from Facebook Business Manager: https://business.facebook.com/
VITE_FB_PIXEL_ID=

# ============================================================================
# Forms & Lead Capture
# ============================================================================

# Google reCAPTCHA v3 Site Key (Public - safe to expose)
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Web3Forms Access Key (Get from https://web3forms.com)
# Used for contact form submissions
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# ============================================================================
# Site Configuration
# ============================================================================

# Environment (development, staging, production)
VITE_ENVIRONMENT=development

# Site URL (for sitemap and meta tags)
VITE_SITE_URL=https://equissetix.com

# API Base URL (if connecting to backend)
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable exit-intent popup
VITE_ENABLE_EXIT_POPUP=true

# Enable/disable analytics tracking
VITE_ENABLE_ANALYTICS=true

# Enable/disable live chat widget (if integrated)
VITE_ENABLE_CHAT=false
